// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider      = "prisma-client-js"
  output        = "../lib/generated/prisma"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "linux-musl-arm64-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// CORE USER MODEL
// ==========================================

model User {
  id          String    @id @default(cuid())
  name        String?
  email       String    @unique
  phone       String?
  clerkUserId String?   @unique
  avatar      String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isAdmin     Boolean   @default(false)
  nationalId  String?
  address     String?
  dateOfBirth DateTime? // Date of birth for KYC

  // Relations
  memberships         Membership[]
  ownedGroups         Group[]                @relation("GroupOwner")
  transactions        Transaction[]
  personalSavings     PersonalSavings?
  savingsGoals        SavingsGoal[]
  notifications       Notification[]
  sentInvitations     GroupInvitation[]      @relation("SentInvitations")
  receivedInvitations GroupInvitation[]      @relation("ReceivedInvitations")
  wallet              Wallet?
  contributions       Contribution[]
  loanRequests        LoanRequest[]          @relation("UserLoanRequests")
  loanVotes           LoanVote[]             @relation("UserLoanVotes")
  personalDocuments   PersonalLoanDocuments?
  solarDocuments      SolarLoanDocuments?
  individualLoans     IndividualLoan[]
  insurancePolicies   InsurancePolicy[]      @relation("UserInsurancePolicies")

  // Pollen Ledger Relations
  memberBalance         MemberBalance?
  ledgerEntries         LedgerEntry[]
  interestDistributions InterestDistribution[]
}

// ==========================================
// BLOG MODELS
// ==========================================

model BlogPost {
  id              String         @id @default(cuid())
  title           String
  Description     String
  author          String
  author_Position String
  category        String?
  status          String?        @default("draft")
  Blog_image      String
  blog_tags       String[]
  read_time       String
  likes           Int            @default(0)
  views           Int            @default(0)
  engagement      Float          @default(0)
  posted_at       DateTime       @default(now())
  updated_at_Date DateTime       @default(now())
  blog_comments   BlogComment[]
  blog_bookmarks  BlogBookmark[]
  blog_likes      BlogLike[]
}

model BlogCategory {
  id          String @id @default(cuid())
  name        String
  description String
}

model BlogComment {
  id            String   @id @default(cuid())
  comment       String   @db.Text
  comment_by    String
  comment_at    DateTime @default(now())
  comment_likes Int      @default(0)
  blog_post_id  String
  parent_id     String?
  audio_url     String?

  // Sentiment Analysis Fields
  sentiment           String?
  sentimentScore      Float?
  sentimentConfidence Float?
  emotions            String[]  @default([])
  analyzedAt          DateTime?

  // Content Moderation Fields
  moderationStatus String?   @default("pending")
  moderationScore  Float?
  moderationFlags  String[]  @default([])
  moderatedAt      DateTime?
  moderatedBy      String?

  blog_post BlogPost      @relation(fields: [blog_post_id], references: [id], onDelete: Cascade)
  parent    BlogComment?  @relation("CommentReplies", fields: [parent_id], references: [id], onDelete: Cascade)
  replies   BlogComment[] @relation("CommentReplies")

  @@index([blog_post_id])
  @@index([parent_id])
  @@index([comment_by])
  @@index([comment_at])
  @@index([moderationStatus])
}

model BlogBookmark {
  id           String   @id @default(cuid())
  user_id      String
  blog_post_id String
  blog_post    BlogPost @relation(fields: [blog_post_id], references: [id], onDelete: Cascade)
  created_at   DateTime @default(now())

  @@unique([user_id, blog_post_id])
  @@index([user_id])
  @@index([blog_post_id])
}

model BlogLike {
  id           String   @id @default(cuid())
  user_id      String
  blog_post_id String
  blog_post    BlogPost @relation(fields: [blog_post_id], references: [id], onDelete: Cascade)
  created_at   DateTime @default(now())

  @@unique([user_id, blog_post_id])
  @@index([user_id])
  @@index([blog_post_id])
}

model UserFollow {
  id          String   @id @default(cuid())
  follower_id String
  author_name String
  created_at  DateTime @default(now())

  @@unique([follower_id, author_name])
  @@index([follower_id])
  @@index([author_name])
}

// ==========================================
// SERVICE MODEL
// ==========================================

model Service {
  id           String   @id @default(cuid())
  name         String
  nameKey      String?
  description  String
  category     String
  status       String   @default("active")
  icon         String?
  image        String?
  users        Int?     @default(0)
  revenue      Int?     @default(0)
  growth       Float?   @default(0)
  keyFeatures  String[]
  requirements String[]
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@index([category])
  @@index([status])
}

// ==========================================
// GROUP & MEMBERSHIP MODELS
// ==========================================

model Group {
  id                    String                @id @default(cuid())
  name                  String
  description           String?
  logo                  String?
  groupCode             String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  ownerId               String
  owner                 User                  @relation("GroupOwner", fields: [ownerId], references: [id])
  privacy               GroupPrivacy          @default(PRIVATE)
  governanceType        GovernanceType        @default(ADMIN)
  contributionAmount    Decimal               @default(0)
  contributionFrequency ContributionFrequency @default(MONTHLY)
  depositGoal           Decimal?
  latePenaltyFee        Decimal               @default(0)
  gracePeriod           Int                   @default(3)
  interestRate          Decimal               @default(0)
  allowEarlyWithdrawal  Boolean               @default(false)
  earlyWithdrawalFee    Decimal               @default(0)
  requireApproval       Boolean               @default(true)
  autoReminders         Boolean               @default(true)
  votingThreshold       Int                   @default(50)
  allowLateJoining      Boolean               @default(true)
  groupDuration         Int?
  maxMembers            Int?
  meetingFrequency      MeetingFrequency      @default(WEEKLY)
  groupRules            String?               @db.Text
  bylaws                String?               @db.Text
  tags                  String?
  status                GroupStatus           @default(ACTIVE)

  // Relations
  memberships       Membership[]
  transactions      Transaction[]
  meetings          Meeting[]
  invitations       GroupInvitation[]
  contributions     Contribution[]
  loanRequests      LoanRequest[]     @relation("GroupLoanRequests")
  insurancePolicies InsurancePolicy[] @relation("GroupInsurancePolicies")

  // Pollen Ledger Relations
  villageLedger VillageLedger?
  aavePosition  AavePosition?
}

model Membership {
  id               String           @id @default(cuid())
  userId           String
  user             User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId          String
  group            Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role             MembershipRole   @default(MEMBER)
  joinedAt         DateTime         @default(now())
  status           MembershipStatus @default(ACTIVE)
  balance          Decimal          @default(0)
  totalContributed Decimal          @default(0)
  lastContribution DateTime?

  // Relations
  votes            Vote[]
  meetingAttendees MeetingAttendee[]
  voteResults      VoteResult[]
  loanVotes        LoanVote[]        @relation("MembershipLoanVotes")
  chairedMeetings  Meeting[]         @relation("MeetingChairperson")
  noteTakerMeetings Meeting[]        @relation("MeetingNoteTaker")

  @@unique([userId, groupId])
}

// ==========================================
// TRANSACTION MODEL
// ==========================================

model Transaction {
  id            String            @id @default(cuid())
  amount        Decimal
  type          TransactionType
  status        TransactionStatus @default(PENDING)
  description   String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId       String?
  group         Group?            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  momoNumber    String?
  reference     String?           @unique
  feeAmount     Decimal?
  walletId      String?
  wallet        Wallet?           @relation(fields: [walletId], references: [id], onDelete: Cascade)
  contribution  Contribution?
  loanRequestId String?
  loanRequest   LoanRequest?      @relation(fields: [loanRequestId], references: [id], onDelete: Cascade)
}

// ==========================================
// SAVINGS MODELS
// ==========================================

model PersonalSavings {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance   Decimal  @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SavingsGoal {
  id            String               @id @default(cuid())
  name          String
  targetAmount  Decimal
  currentAmount Decimal              @default(0)
  deadline      DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  userId        String
  user          User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  isCompleted   Boolean              @default(false)
  transactions  SavingsTransaction[]
  aiAnalyses    AIGoalAnalysis[]
}

model SavingsTransaction {
  id            String   @id @default(cuid())
  savingsGoalId String
  amount        Float
  type          String
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  savingsGoal SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)

  @@index([savingsGoalId])
}

model AIGoalAnalysis {
  id                          String   @id @default(cuid())
  savingsGoalId               String
  creditScore                 Int
  scoreCategory               String
  riskLevel                   String
  analysis                    String   @db.Text
  recommendations             String[]
  predictedCompletionDate     DateTime
  onTrack                     Boolean
  confidence                  Int
  progressPercentage          Decimal
  avgMonthlyContribution      Decimal
  requiredMonthlyContribution Decimal
  daysUntilDeadline           Int
  remainingAmount             Decimal
  createdAt                   DateTime @default(now())

  savingsGoal SavingsGoal @relation(fields: [savingsGoalId], references: [id], onDelete: Cascade)

  @@index([savingsGoalId])
  @@index([createdAt])
}

// ==========================================
// MEETING & VOTING MODELS
// ==========================================

model Meeting {
  id          String            @id @default(cuid())
  title       String
  description String?
  agenda      String[]          @default([])
  date        DateTime
  location    String?
  isVirtual   Boolean           @default(false)
  meetingLink String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  groupId     String
  group       Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  attendees   MeetingAttendee[]
  chairpersonMembershipId String?
  chairperson             Membership?       @relation("MeetingChairperson", fields: [chairpersonMembershipId], references: [id])
  noteTakerMembershipId   String?
  noteTaker               Membership?       @relation("MeetingNoteTaker", fields: [noteTakerMembershipId], references: [id])
}

model MeetingAttendee {
  id           String           @id @default(cuid())
  meetingId    String
  meeting      Meeting          @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  membershipId String
  membership   Membership       @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  status       AttendanceStatus @default(PENDING)

  @@unique([meetingId, membershipId])
}

model Vote {
  id           String       @id @default(cuid())
  title        String
  description  String?
  options      Json
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  membershipId String
  membership   Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  voteResults  VoteResult[]
}

model VoteResult {
  id             String     @id @default(cuid())
  voteId         String
  vote           Vote       @relation(fields: [voteId], references: [id], onDelete: Cascade)
  membershipId   String
  membership     Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  selectedOption String
  votedAt        DateTime   @default(now())

  @@unique([voteId, membershipId])
}

// ==========================================
// NOTIFICATION MODEL
// ==========================================

model Notification {
  id                   String           @id @default(cuid())
  title                String
  message              String
  type                 NotificationType
  isRead               Boolean          @default(false)
  createdAt            DateTime         @default(now())
  userId               String
  user                 User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedGroupId       String?
  relatedTransactionId String?
  relatedLoanRequestId String?
}

// ==========================================
// LOAN DOCUMENT MODELS
// ==========================================

model PersonalLoanDocuments {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Nrcfront        String
  NrcBack         String
  PaySlip         String
  ProofOfAddress  String?
  LiveSelfie      String?
  BankStatement   String?
  VideoKycUrl     String? // Level 3: Video KYC recording URL
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model SolarLoanDocuments {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  Nrcfront        String
  NrcBack         String
  LandOwnership   String
  UtilityBill     String
  VendorQuotation String
  SubsidyReceipt  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// ==========================================
// GROUP INVITATION MODEL
// ==========================================

model GroupInvitation {
  id        String           @id @default(cuid())
  groupId   String
  group     Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  inviterId String
  inviter   User             @relation("SentInvitations", fields: [inviterId], references: [id])
  inviteeId String
  invitee   User             @relation("ReceivedInvitations", fields: [inviteeId], references: [id])
  status    InvitationStatus @default(PENDING)
  code      String           @unique
  createdAt DateTime         @default(now())
  expiresAt DateTime?
}

// ==========================================
// WALLET MODEL
// ==========================================

model Wallet {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance      Decimal       @default(0)
  celoAddress  String?       @unique
  privateKey   String?
  celoBalance  String?       @default("0")
  cusdBalance  String?       @default("0")
  ceurBalance  String?       @default("0")
  network      String?       @default("alfajores")
  isConnected  Boolean       @default(false)
  connectedAt  DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]
}

// ==========================================
// CONTRIBUTION MODEL
// ==========================================

model Contribution {
  id            String            @id @default(cuid())
  amount        Decimal
  status        TransactionStatus @default(PENDING)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  userId        String
  user          User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId       String
  group         Group             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactionId String?           @unique
  transaction   Transaction?      @relation(fields: [transactionId], references: [id], onDelete: Cascade)
}

// ==========================================
// LOAN MODELS
// ==========================================

model LoanRequest {
  id             String        @id @default(cuid())
  amount         Decimal
  purpose        String        @db.Text
  repaymentDate  DateTime
  repaymentTerms String        @db.Text
  installments   Int           @default(1)
  interestRate   Decimal       @default(0)
  status         LoanStatus    @default(PENDING)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  userId         String
  user           User          @relation("UserLoanRequests", fields: [userId], references: [id], onDelete: Cascade)
  groupId        String
  group          Group         @relation("GroupLoanRequests", fields: [groupId], references: [id], onDelete: Cascade)
  transactions   Transaction[]
  votes          LoanVote[]    @relation("LoanRequestVotes")
}

model LoanVote {
  id            String      @id @default(cuid())
  vote          Boolean
  comment       String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  userId        String
  user          User        @relation("UserLoanVotes", fields: [userId], references: [id], onDelete: Cascade)
  loanRequestId String
  loanRequest   LoanRequest @relation("LoanRequestVotes", fields: [loanRequestId], references: [id], onDelete: Cascade)
  membershipId  String
  membership    Membership  @relation("MembershipLoanVotes", fields: [membershipId], references: [id], onDelete: Cascade)

  @@unique([userId, loanRequestId])
}

model IndividualLoan {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  serviceType      String
  serviceName      String
  serviceCategory  String
  amount           Decimal
  purpose          String     @db.Text
  repaymentPeriod  String
  fullName         String
  email            String
  phone            String
  nationalId       String
  address          String     @db.Text
  employmentStatus String
  monthlyIncome    Decimal?
  businessDetails  String?    @db.Text
  status           LoanStatus @default(PENDING)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([userId])
  @@index([status])
}

// ==========================================
// CONTACT & MEETING REQUEST MODELS
// ==========================================

model ContactMessage {
  id               String   @id @default(cuid())
  name             String
  email            String
  phone            String?
  subject          String
  message          String   @db.Text
  department       String
  preferredContact String   @default("email")
  timeframe        String   @default("anytime")
  status           String   @default("new")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([department])
  @@index([createdAt])
}

model MeetingRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  phone       String?
  meetingDate DateTime
  meetingTime String
  purpose     String?  @db.Text
  status      String   @default("pending")
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([status])
  @@index([meetingDate])
  @@index([createdAt])
}

// ==========================================
// INSURANCE MODELS
// ==========================================

model InsuranceProduct {
  id                  String   @id @default(cuid())
  name                String
  productType         String // crop, health, loan_protection, savings_fraud, mobile, weather
  description         String   @db.Text
  coverageAmount      Decimal
  premiumAmount       Decimal
  premiumFrequency    String // seasonal, monthly, annual
  features            String[]
  requirements        String[]
  status              String   @default("active") // active, inactive, suspended
  claimProcessingTime String? // e.g., "7-14 days"
  maxClaimAmount      Decimal?
  deductible          Decimal? @default(0)
  coverageTerms       String?  @db.Text // Terms and conditions for coverage
  exclusions          String?  @db.Text // List of exclusions
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  policies InsurancePolicy[]

  @@index([productType])
  @@index([status])
}

model InsurancePolicy {
  id           String           @id @default(cuid())
  policyNumber String           @unique
  productId    String
  product      InsuranceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId       String
  user         User             @relation("UserInsurancePolicies", fields: [userId], references: [id], onDelete: Cascade)
  groupId      String?
  group        Group?           @relation("GroupInsurancePolicies", fields: [groupId], references: [id], onDelete: Cascade)

  // Coverage Details
  coverageAmount   Decimal
  premiumAmount    Decimal
  premiumFrequency String
  startDate        DateTime
  endDate          DateTime
  renewalDate      DateTime?

  // Status
  status          String    @default("active") // active, expired, cancelled, claimed
  paymentStatus   String    @default("pending") // pending, paid, overdue
  lastPremiumPaid DateTime?
  nextPremiumDue  DateTime?

  // Additional Details
  beneficiaries String[]
  documents     String[]
  notes         String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  claims   InsuranceClaim[]
  payments InsurancePremium[]

  @@index([userId])
  @@index([groupId])
  @@index([productId])
  @@index([status])
  @@index([policyNumber])
}

model InsuranceClaim {
  id          String          @id @default(cuid())
  claimNumber String          @unique
  policyId    String
  policy      InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  // Claim Details
  claimType      String
  claimAmount    Decimal
  approvedAmount Decimal?
  incidentDate   DateTime
  claimDate      DateTime @default(now())
  description    String   @db.Text

  // Supporting Documents
  documents    String[]
  evidenceUrls String[]

  // Status & Processing
  status     String    @default("submitted") // submitted, pending, processing, under_review, approved, rejected, paid
  priority   String    @default("normal") // low, normal, high, urgent
  assignedTo String?
  reviewedBy String?
  reviewedAt DateTime?
  approvedBy String?
  approvedAt DateTime?
  paidAt     DateTime?

  // Rejection/Notes
  rejectionReason String? @db.Text
  internalNotes   String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([policyId])
  @@index([status])
  @@index([claimNumber])
}

model InsurancePremium {
  id             String          @id @default(cuid())
  policyId       String
  policy         InsurancePolicy @relation(fields: [policyId], references: [id], onDelete: Cascade)
  amount         Decimal
  dueDate        DateTime
  paidDate       DateTime?
  paymentMethod  String?
  transactionRef String?
  status         String          @default("pending") // pending, paid, overdue, waived
  createdAt      DateTime        @default(now())

  @@index([policyId])
  @@index([status])
  @@index([dueDate])
}

// ==========================================
// POLLEN LEDGER-DRIVEN FINANCIAL SYSTEM
// ==========================================

// Ledger Engine - Source of Truth
model LedgerEntry {
  id      String @id @default(cuid())
  entryId String @unique // Human-readable entry ID (e.g., "L001")

  // Entry Details
  type     LedgerEntryType
  amount   Decimal
  asset    String // cUSD, CELO, ZMW, etc.
  currency String          @default("ZMW") // ZMW (fiat) or CELO (crypto)

  // User/Entity References
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])
  groupId     String?
  description String? @db.Text
  reference   String? // External reference (loan ID, contribution ID, etc.)

  // Blockchain Details (for crypto transactions)
  txHash        String?
  blockNumber   Int?
  walletAddress String?
  networkId     String? // celo-mainnet, celo-alfajores
  gasUsed       Decimal?
  gasFee        Decimal?

  // Status & Verification
  status        LedgerStatus @default(PENDING)
  confirmations Int          @default(0)
  confirmedAt   DateTime?

  // Reconciliation
  reconciled       Boolean              @default(false)
  reconciledAt     DateTime?
  reconciliationId String?
  reconciliation   DailyReconciliation? @relation(fields: [reconciliationId], references: [id])

  // Reversal tracking
  reversalOfId String?
  reversalOf   LedgerEntry?  @relation("EntryReversal", fields: [reversalOfId], references: [id])
  reversedBy   LedgerEntry[] @relation("EntryReversal")

  // Audit
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([groupId])
  @@index([type])
  @@index([status])
  @@index([currency])
  @@index([createdAt])
  @@index([reconciliationId])
}

// Wallet Execution Layer
model WalletExecution {
  id String @id @default(cuid())

  // Execution Details
  executionType ExecutionType
  direction     ExecutionDirection
  amount        Decimal
  asset         String
  currency      String

  // Source/Destination
  fromAddress     String?
  toAddress       String?
  fromAccountName String?
  toAccountName   String?

  // Bank/Mobile Money Details
  bankName       String?
  accountNumber  String?
  mobileNumber   String?
  mobileProvider String? // MTN, Airtel, Zamtel

  // Blockchain Details
  txHash      String?
  blockNumber Int?
  networkId   String?
  gasLimit    Decimal?
  gasPrice    Decimal?
  gasUsed     Decimal?
  nonce       Int?

  // Status
  status       ExecutionStatus @default(PENDING)
  errorMessage String?         @db.Text
  retryCount   Int             @default(0)

  // Timestamps
  submittedAt DateTime?
  confirmedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([executionType])
  @@index([status])
  @@index([txHash])
  @@index([createdAt])
}

// Village Banking Ledger (Group-level tracking)
model VillageLedger {
  id      String @id @default(cuid())
  groupId String @unique
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Running Totals
  totalContributions  Decimal @default(0)
  totalLoansIssued    Decimal @default(0)
  totalRepayments     Decimal @default(0)
  totalPenalties      Decimal @default(0)
  totalInterestEarned Decimal @default(0)
  totalFeesCharged    Decimal @default(0)
  currentBalance      Decimal @default(0)

  // Member Stats
  activeMemberCount Int @default(0)
  totalMemberCount  Int @default(0)

  // Status
  status         VillageLedgerStatus @default(ACTIVE)
  lastActivityAt DateTime?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  entries VillageLedgerEntry[]

  @@index([groupId])
  @@index([status])
}

model VillageLedgerEntry {
  id              String        @id @default(cuid())
  villageLedgerId String
  villageLedger   VillageLedger @relation(fields: [villageLedgerId], references: [id], onDelete: Cascade)

  // Entry Details
  type           VillageLedgerEntryType
  amount         Decimal
  runningBalance Decimal // Balance after this entry

  // Member Info
  memberId   String
  memberName String

  // Reference
  reference   String? // Loan ID, contribution ID, etc.
  description String?

  // Status
  status LedgerStatus @default(CONFIRMED)

  createdAt DateTime @default(now())

  @@index([villageLedgerId])
  @@index([memberId])
  @@index([type])
  @@index([createdAt])
}

// Savings Interest Flow
model InterestFlow {
  id String @id @default(cuid())

  // Period
  periodStart DateTime
  periodEnd   DateTime
  periodType  InterestPeriodType

  // Principal
  savingsPrincipal Decimal

  // Yield Breakdown
  grossInterest      Decimal @default(0)
  platformFee        Decimal @default(0)
  platformFeeRate    Decimal @default(0.10) // 10% default
  netInterestToUsers Decimal @default(0)

  // Status
  status        InterestFlowStatus @default(CALCULATED)
  distributedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  yieldSources  YieldSource[]
  distributions InterestDistribution[]

  @@index([periodStart])
  @@index([periodEnd])
  @@index([status])
}

model YieldSource {
  id             String       @id @default(cuid())
  interestFlowId String
  interestFlow   InterestFlow @relation(fields: [interestFlowId], references: [id], onDelete: Cascade)

  sourceName      String // AAVE_SUPPLY, LENDING_INTEREST, STAKING_REWARDS, etc.
  sourceType      YieldSourceType
  principalAmount Decimal
  rate            Decimal // APY as decimal (e.g., 0.025 for 2.5%)
  earnedAmount    Decimal

  // External Reference
  externalId String? // AAVE position ID, etc.

  createdAt DateTime @default(now())

  @@index([interestFlowId])
  @@index([sourceType])
}

model InterestDistribution {
  id             String       @id @default(cuid())
  interestFlowId String
  interestFlow   InterestFlow @relation(fields: [interestFlowId], references: [id], onDelete: Cascade)

  // Recipient
  userId  String
  user    User    @relation(fields: [userId], references: [id])
  groupId String?

  // Distribution Details
  principalShare Decimal // User's share of principal
  interestAmount Decimal // Interest earned
  feeDeducted    Decimal // Platform fee deducted
  netAmount      Decimal // Final amount credited

  // Status
  status        DistributionStatus @default(PENDING)
  creditedAt    DateTime?
  ledgerEntryId String? // Reference to LedgerEntry

  createdAt DateTime @default(now())

  @@index([interestFlowId])
  @@index([userId])
  @@index([groupId])
  @@index([status])
}

// Daily Reconciliation
model DailyReconciliation {
  id String @id @default(cuid())

  // Period
  reconciliationDate DateTime

  // Balances
  ledgerBalance     Decimal // Total from LedgerEngine
  bankBalance       Decimal // Total in traditional banking
  blockchainBalance Decimal // Total on blockchain
  totalExecuted     Decimal // Bank + Blockchain

  // Difference Analysis
  difference        Decimal @default(0)
  differencePercent Decimal @default(0)

  // Status
  status     ReconciliationStatus @default(PENDING)
  matchedAt  DateTime?
  resolvedAt DateTime?
  resolvedBy String?

  // Notes
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts  ReconciliationAlert[]
  entries LedgerEntry[]

  @@unique([reconciliationDate])
  @@index([status])
  @@index([reconciliationDate])
}

model ReconciliationAlert {
  id               String              @id @default(cuid())
  reconciliationId String
  reconciliation   DailyReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)

  // Alert Details
  alertType   AlertType
  severity    AlertSeverity
  description String        @db.Text
  amount      Decimal?

  // Related Entities
  relatedEntryIds String[]
  relatedTxHashes String[]

  // Resolution
  status     AlertStatus @default(OPEN)
  resolution String?     @db.Text
  resolvedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reconciliationId])
  @@index([alertType])
  @@index([severity])
  @@index([status])
}

// Member Balance Tracking
model MemberBalance {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Fiat Balances
  fiatBalance  Decimal @default(0)
  fiatCurrency String  @default("ZMW")

  // Crypto Balances
  celoBalance Decimal @default(0)
  cusdBalance Decimal @default(0)
  ceurBalance Decimal @default(0)

  // Locked/Available
  lockedFiat    Decimal @default(0)
  lockedCelo    Decimal @default(0)
  availableFiat Decimal @default(0)
  availableCelo Decimal @default(0)

  // Interest Tracking
  totalInterestEarned Decimal @default(0)
  pendingInterest     Decimal @default(0)

  // Wallet Info
  primaryWalletAddress String?

  // Last Activity
  lastTransactionAt    DateTime?
  lastInterestCreditAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// Hub Assets (Available liquidity pools)
model HubAsset {
  id String @id @default(cuid())

  // Asset Info
  symbol          String  @unique
  name            String
  contractAddress String?
  decimals        Int     @default(18)

  // Liquidity
  totalLiquidity     Decimal @default(0)
  availableLiquidity Decimal @default(0)
  utilizationRate    Decimal @default(0)

  // Interest Rates
  supplyAPY          Decimal @default(0)
  borrowAPY          Decimal @default(0)
  baseRate           Decimal @default(0)
  optimalUtilization Decimal @default(0.8)

  // Collateral Settings
  ltv                  Decimal @default(0)
  liquidationThreshold Decimal @default(0)
  liquidationPenalty   Decimal @default(0)

  // Status
  isActive  Boolean @default(true)
  canSupply Boolean @default(true)
  canBorrow Boolean @default(true)

  // Price
  priceUSD       Decimal   @default(0)
  priceUpdatedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([symbol])
  @@index([isActive])
}

// ==========================================
// AAVE INTEGRATION MODELS
// ==========================================

model AavePosition {
  id           String  @id @default(cuid())
  groupId      String  @unique
  group        Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  spokeAddress String? // Smart contract address for this group's AAVE spoke

  // Health metrics
  healthFactor         Decimal @default(0)
  totalSupplied        Decimal @default(0)
  totalBorrowed        Decimal @default(0)
  availableToBorrow    Decimal @default(0)
  netAPY               Decimal @default(0)
  liquidationThreshold Decimal @default(0)
  liquidationRisk      String  @default("low") // low, medium, high

  // Status
  isActive    Boolean  @default(true)
  lastUpdated DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  supplies     AaveSupply[]
  borrows      AaveBorrow[]
  transactions AaveTransaction[]

  @@index([groupId])
  @@index([spokeAddress])
  @@index([isActive])
}

model AaveSupply {
  id          String       @id @default(cuid())
  positionId  String
  position    AavePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  assetSymbol String
  amount      Decimal
  apy         Decimal
  ltv         Decimal
  balance     Decimal
  valueUSD    Decimal
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([positionId])
  @@index([assetSymbol])
}

model AaveBorrow {
  id          String       @id @default(cuid())
  positionId  String
  position    AavePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  assetSymbol String
  amount      Decimal
  apy         Decimal
  balance     Decimal
  valueUSD    Decimal
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([positionId])
  @@index([assetSymbol])
}

model AaveTransaction {
  id          String       @id @default(cuid())
  positionId  String
  position    AavePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)
  type        String // SUPPLY, BORROW, REPAY, WITHDRAW
  assetSymbol String
  amount      Decimal
  txHash      String?
  status      String       @default("pending") // pending, confirmed, failed
  timestamp   DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([positionId])
  @@index([type])
  @@index([timestamp])
}

